# Llama-R Configuration Example

# Server configuration
PORT=3000
LOG_LEVEL=info

# Provider selection: ollama (default) | openrouter | opencode.
# One value selects chat, the decision router and (where supported) embeddings.
PROVIDER=ollama

# Ollama provider configuration
OLLAMA_URL=http://localhost:11434
# DEFAULT_MODEL=llama3.2

# OpenRouter: Bearer API key, kept in .env (mode 0600), never in URLs/logs/health.
# OPENROUTER_API_KEY=your_openrouter_key
# OpenAI-compatible base URL; defaults to OpenRouter's https://openrouter.ai/api/v1.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# OpenCode: server password sent as HTTP basic auth (never in a URL), and origin.
# OPENCODE_API_KEY=your_opencode_password
# OPENCODE_URL=http://127.0.0.1:4096

# RAG / embeddings. Ollama and OpenRouter serve embeddings; OpenCode does not.
# With OpenCode and no OLLAMA_URL, RAG is disabled (/api/rag/* answers 501).
# Ollama embeddings can still be used as an OpenCode fallback if OLLAMA_URL is set.
# Pull first: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
RAG_ENABLED=true

# Conversation history (SQLite at data/history.db)
# 0 = never purge (keep all conversations)
HISTORY_RETENTION_DAYS=90

# Agent routing (opt-in, off by default). Needs a d1 decision model on
# llama.cpp — Ollama cannot serve it:
#   llama-server -hf LiquidAI/d1-3B-GGUF:Q8_0
# Check the port against your build: recent llama.cpp listens on 9931, older
# ones on 8080. Copy it from the "listening on" line the server prints.
# ROUTER_URL is a separate port from PORT (3000 above); they must not collide.
# Optional {base}/router.toml overrides these values (thresholds + exclude).
ROUTER_ENABLED=false
ROUTER_URL=http://127.0.0.1:8080
# Log-only label; the model is whichever one llama-server was started with.
ROUTER_MODEL=d1-3b
# Raise this without a GPU: a d1-3B decision takes 2.4-3.3 s on an 8-core
# CPU, so 3000 degrades every decision to the general agent without erroring.
ROUTER_TIMEOUT_MS=3000
MIN_CONFIDENCE=0.60
MIN_SPECIALIZED=0.50

# gRPC configuration (planned)
# GRPC_PORT=50051

# Model Validation Cache (planned)
# MODEL_CACHE_TTL_MINS=60
