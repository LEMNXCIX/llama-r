# Llama-R Configuration Example

# Server configuration
PORT=8080
LOG_LEVEL=info

# Ollama provider configuration
OLLAMA_URL=http://localhost:11434
# DEFAULT_MODEL=llama3.2

# RAG / embeddings (Ollama)
# Pull first: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
RAG_ENABLED=true

# Conversation history (SQLite at data/history.db)
# 0 = never purge (keep all conversations)
HISTORY_RETENTION_DAYS=90

# Future provider configurations
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key

# gRPC configuration (planned)
# GRPC_PORT=50051

# Model Validation Cache (planned)
# MODEL_CACHE_TTL_MINS=60
