# Llama-R Configuration Example
# Copy to .env: cp .env.example .env
# One PROVIDER selects chat, the decision router and (where supported) embeddings.
# Every variable below is read by Config::from_env, RouterConfig::from_env or a
# built-in providers.toml profile. Keys are secrets: never in URLs, logs, health
# responses or the TUI.

# ---- Server ----
PORT=3000
# Optional base dir override for agents/, contextos/, data/ and providers.toml:
# LLAMA_R_DIR=/path/to/llama-r-data

# ---- Network hardening ----
# Outbound HTTP timeout (ms). 0 is rejected. Default: 30000.
HTTP_TIMEOUT_MS=30000
# Comma-separated allowed CORS origins. Loopback by default; "*" is rejected.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ---- Provider selection ----
# ollama (default) | openrouter | opencode | openai-compatible | anthropic | gemini
# An agent manifest may override this per request with its own `provider` field.
# Optional providers.toml (in the base dir) defines profiles:
#   [providers.<name>]
#   type = "ollama|openrouter|opencode|openai-compatible|anthropic|gemini"
#   base_url = "https://..."
#   api_key_env = "VAR_NAME"   # NAME of the env var holding the key, never a key
#   timeout_ms = 30000
PROVIDER=ollama

# ---- Ollama ----
OLLAMA_URL=http://localhost:11434
# DEFAULT_MODEL=llama3.2

# ---- OpenRouter ----
# Bearer key, kept in .env (mode 0600), never in URLs/logs/health.
# OPENROUTER_API_KEY=your_openrouter_key
# OpenAI-compatible base URL (also used by PROVIDER=openai-compatible);
# defaults to https://openrouter.ai/api/v1 for OpenRouter. Together with
# OPENROUTER_API_KEY it also backs embeddings for providers with no endpoint
# of their own (opencode, anthropic) when OLLAMA_URL is empty. The key is sent
# in a header, never in a URL or log.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---- OpenAI-compatible (Groq/Mistral/DeepSeek/xAI/self-hosted gateways) ----
# Bearer key; base URL comes from the profile or OPENAI_BASE_URL.
# OPENAI_API_KEY=your_openai_compatible_key

# ---- Anthropic ----
# Sent in an x-api-key header (never a URL or Bearer header).
# ANTHROPIC_API_KEY=your_anthropic_key

# ---- Gemini ----
# Sent in an x-goog-api-key header (never as ?key= in a URL).
# GEMINI_API_KEY=your_gemini_key

# ---- OpenCode ----
# Server password sent as HTTP basic auth (never in a URL), and origin.
# OPENCODE_API_KEY=your_opencode_password
# OPENCODE_URL=http://127.0.0.1:4096

# ---- RAG / embeddings ----
# Ollama, OpenRouter, OpenAI-compatible and Gemini serve embeddings.
# Anthropic and OpenCode do not: with no OLLAMA_URL or
# OPENAI_BASE_URL/OPENROUTER_API_KEY fallback RAG is disabled and /api/rag/*
# answers an explicit 501 naming embeddings. Ollama embeddings back those
# providers when OLLAMA_URL is set (preferred); otherwise an OpenAI-compatible
# endpoint at OPENAI_BASE_URL with OPENROUTER_API_KEY serves them.
# Pull first: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
RAG_ENABLED=true

# ---- Conversation history (SQLite at data/history.db) ----
# 0 = never purge (keep all conversations)
HISTORY_RETENTION_DAYS=90

# ---- Agent routing (opt-in, off by default) ----
# Needs a d1 decision model on llama.cpp — Ollama cannot serve it:
#   llama-server -hf LiquidAI/d1-3B-GGUF:Q8_0
# Check the port against your build: recent llama.cpp listens on 9931, older
# ones on 8080. Copy it from the "listening on" line the server prints.
# ROUTER_URL is a separate port from PORT (3000 above); they must not collide.
# Optional router.toml overrides these values (thresholds + exclude).
ROUTER_ENABLED=false
ROUTER_URL=http://127.0.0.1:8080
# Log-only label; the model is whichever one llama-server was started with.
ROUTER_MODEL=d1-3b
# Raise this without a GPU: a d1-3B decision takes 2.4-3.3 s on an 8-core
# CPU, so 3000 degrades every decision to the general agent without erroring.
ROUTER_TIMEOUT_MS=3000
MIN_CONFIDENCE=0.60
MIN_SPECIALIZED=0.50

# ---- Admin auth (X-Admin-Token on every /api/* admin route) ----
# Shared token; missing or empty => every admin route fails closed with 401.
# Secret: lives only in .env (mode 0600), never in URLs/logs/health/response.
# ADMIN_TOKEN=your_admin_token

# ---- Approval parking (human-in-the-loop) ----
# true (default): a pending approval never expires; the turn parks until a
# human decides (non-streaming chats answer 202 with execution_id after the grace).
APPROVAL_PARK=true
# Bounded gate deadline in seconds when parking is off (default 120).
# 0 is the other spelling of "no deadline".
APPROVAL_TIMEOUT_SECS=120
# How long the HTTP handler waits before the 202 acknowledgement (default 1000 ms).
PARK_GRACE_MS=1000
# How often the boot reaper looks for decided orphaned turns (default 5 s).
# A non-positive value falls back to 5.
REAPER_INTERVAL_SECS=5

# ---- OTLP/HTTP trace export (opt-in; no OpenTelemetry crate) ----
# false (default): zero telemetry requests. The exporter posts the already-
# redacted trace fields with reqwest — no OTel dependency, no new port.
OTEL_ENABLED=false
OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SERVICE_NAME=llama-r
